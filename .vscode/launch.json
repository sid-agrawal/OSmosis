{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "DebugPy: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "sudo DebugPy: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${workspaceFolder}/scripts/proc",
            "console": "integratedTerminal",
            "sudo": "true",
            "args": [
                "--csv",
                "debug.csv",
                "--os",
                "linux"
            ]
        },
        {
            "name": "run-proc-model-with-sudo",
            "type": "debugpy",
            "cwd": "${workspaceFolder}/scripts/proc",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/proc/proc_model.py",
            "console": "integratedTerminal",
            "sudo": "true",
            "args": [
                "--csv",
                "debug.csv",
                "--os",
                "linux"
            ]
        }
    ]
}