#!/usr/bin/env expect
# Boot the guest under qemu-system-aarch64 and timestamp boot phases.
# Spawns qemu under a PTY so serial output is unbuffered (avoids qemu's
# block-buffering on a pipe). Emits PHASE:<name>:<ms-since-spawn> lines.
#
# Usage:
#   expect boot_phases.exp <kernel> <initrd> <mem> <timeout_s> <cpu> <accel> [extra...]
#     cpu   : e.g. cortex-a53  (TCG) | host (KVM)
#     accel : tcg | kvm
# Markers (direct kernel boot, buildroot 5.18 guest):
#   banner    - "Linux version"      => first Linux instruction (p2; ==p1 direct boot)
#   userspace - "Run /init as init"  => first userspace instruction (p3)
#   login     - "login:"             => login prompt available (p4)

set kernel  [lindex $argv 0]
set initrd  [lindex $argv 1]
set mem     [lindex $argv 2]
set tmo     [lindex $argv 3]
set cpu     [lindex $argv 4]
set accel   [lindex $argv 5]
set extra   [lrange $argv 6 end]

if {$accel eq "kvm"} {
    set machine "virt,gic-version=3"
    set accelargs "-enable-kvm"
} else {
    set machine "virt"
    set accelargs ""
}

set t0 [clock milliseconds]
set timeout $tmo
match_max 200000

proc stamp {name} { global t0; puts "\nPHASE:$name:[expr {[clock milliseconds]-$t0}]"; flush stdout }

spawn qemu-system-aarch64 -M $machine -cpu $cpu {*}$accelargs -smp 1 -m $mem -nographic \
    -kernel $kernel -initrd $initrd \
    -append "earlycon=pl011,0x9000000 console=ttyAMA0 loglevel=8" {*}$extra

# p1/p2: first guest instruction == first Linux instruction (direct boot); earliest observable
# is the kernel's earlycon banner "Booting Linux on physical CPU".
expect {
    -re "Booting Linux on physical CPU" { stamp guest_entry; exp_continue }
    -re "Run /init as init process"     { stamp userspace;   exp_continue }
    -re "Freeing unused kernel memory"  { stamp freeing;     exp_continue }
    -re "login:"                        { stamp login; puts "PHASE:done:[expr {[clock milliseconds]-$t0}]" }
    timeout                             { puts "PHASE:TIMEOUT:[expr {[clock milliseconds]-$t0}]" }
    eof                                 { puts "PHASE:EOF:[expr {[clock milliseconds]-$t0}]" }
}
catch { exec pkill -9 -f "qemu-system-aarch64 -M $machine -cpu $cpu" }
