{
  "name": "Default OS Security Scoring Configuration",
  "version": "1.0",
  "description": "Default configuration for pattern-aware scoring in OS security scenarios",
  
  "resource_type_system": {
    "type_patterns": {
      "FILE_\\d+_\\d+": {
        "extraction_method": "modulo_cycle",
        "modulo_cycle": ["CONFIG", "DATABASE", "TEMP"],
        "id_position": 2,
        "default_type": "FILE"
      },
      "MEMORY_\\d+_\\d+": {
        "extraction_method": "modulo_cycle",
        "modulo_cycle": ["HEAP", "STACK", "SHARED"],
        "id_position": 2,
        "default_type": "MEMORY"
      },
      "NETWORK_\\d+_\\d+": {
        "extraction_method": "modulo_cycle",
        "modulo_cycle": ["TCP", "UDP", "SOCKET"],
        "id_position": 2,
        "default_type": "NETWORK"
      }
    },
    "name_mappings": {
      "FILE_1_1": "CONFIG",
      "FILE_1_2": "DATABASE",
      "FILE_1_3": "TEMP",
      "SPECIAL_CONFIG": "CONFIG",
      "SYSTEM_DATABASE": "DATABASE"
    },
    "attribute_extractors": {
      "size_kb": "extract_from_graph_metadata",
      "permissions": "extract_from_edge_properties",
      "file_type": "extract_from_type_inference"
    }
  },
  
  "constraint_handlers": [
    {
      "name": "ProhibitionConstraintHandler",
      "enabled": true,
      "priority_level": 1,
      "config": {
        "violation_removal_score": 3.0,
        "violation_creation_penalty": 0.0
      }
    },
    {
      "name": "AccessRequirementHandler", 
      "enabled": true,
      "priority_level": 2,
      "config": {
        "private_alternative_score": 2.9,
        "requirement_satisfaction_score": 1.5,
        "indirect_access_score": 1.8
      }
    },
    {
      "name": "ExistenceConstraintHandler",
      "enabled": true,
      "priority_level": 2,
      "config": {
        "required_resource_creation_score": 1.2,
        "required_resource_removal_penalty": 0.0
      }
    },
    {
      "name": "CommunicationConstraintHandler",
      "enabled": true,
      "priority_level": 3,
      "config": {
        "communication_satisfaction_score": 1.0
      }
    }
  ],
  
  "pattern_detectors": [
    {
      "name": "MediationPatternDetector",
      "enabled": true,
      "priority_level": 2,
      "config": {
        "mediator_creation_score": 1.5,
        "orphaned_connection_score": 2.5,
        "constraint_mentioned_orphaned_score": 3.0,
        "mediation_completion_score": 1.8,
        "shared_removal_for_mediation_score": 1.0
      }
    },
    {
      "name": "SharingReductionPatternDetector",
      "enabled": true,
      "priority_level": 2,
      "config": {
        "shared_removal_score": 2.8,
        "private_alternative_score": 2.9,
        "sharing_increase_penalty": 0.1,
        "private_resource_boost": 1.2,
        "alternative_creation_score": 1.5
      }
    },
    {
      "name": "IsolationViolationDetector",
      "enabled": true,
      "priority_level": 3,
      "config": {
        "dependency_reduction_score": 1.5,
        "isolation_improvement_score": 1.3
      }
    },
    {
      "name": "PrivilegeEscalationPreventionDetector",
      "enabled": false,
      "priority_level": 3,
      "config": {
        "authority_concentration_penalty": 0.3,
        "authority_distribution_bonus": 1.4
      }
    }
  ],
  
  "scoring_policies": {
    "combination_method": "priority_override",
    "weights": {
      "constraint": 0.6,
      "pattern": 0.3,
      "base": 0.1
    },
    "sequence_bonuses": {
      "enabled": true,
      "decay_factor": 0.9,
      "infrastructure_after_removal": 0.5,
      "connection_after_removal": 0.3
    }
  },
  
  "base_scores": {
    "privatize_resource": 1.0,
    "add_mediator": 0.5,
    "remove_file_resource": 0.4,
    "add_file_resource": 0.6,
    "remove_hold_edge": 0.5,
    "add_hold_edge": 0.4,
    "remove_pd": 0.3,
    "add_subset_edge": 0.3,
    "remove_subset_edge": 0.3,
    "add_request_edge": 0.2,
    "remove_request_edge": 0.3,
    "add_pd": 0.2,
    "add_resource_space": 0.1,
    "remove_resource_space": 0.2
  },
  
  "domains": {
    "os_security": {
      "enabled_patterns": ["MediationPatternDetector", "SharingReductionPatternDetector", "IsolationViolationDetector"],
      "enabled_constraints": ["ProhibitionConstraintHandler", "AccessRequirementHandler", "ExistenceConstraintHandler"]
    },
    "network_security": {
      "enabled_patterns": ["IsolationViolationDetector", "PrivilegeEscalationPreventionDetector"],
      "enabled_constraints": ["ProhibitionConstraintHandler", "CommunicationConstraintHandler"]
    },
    "privilege_separation": {
      "enabled_patterns": ["MediationPatternDetector", "PrivilegeEscalationPreventionDetector"],
      "enabled_constraints": ["ProhibitionConstraintHandler", "AccessRequirementHandler"]
    }
  }
}